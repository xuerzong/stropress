---
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import DocToc from '../components/DocToc.astro'
import Footer from '../components/Footer.astro'
import BaseHead from '../components/BaseHead.astro'
import { getResolvedSiteConfig } from '../lib/config'
import { customGlobalStyle } from '../lib/custom-style'
import '../styles/global.css'
import '../styles/markdown.css'

interface Props {
  title?: string
  description?: string
  sidebar?: boolean
  contentClass?: string
  tocHeadings?: Array<{
    depth: number
    slug: string
    text: string
  }>
}

const {
  title,
  description,
  sidebar = true,
  contentClass = '',
  tocHeadings = [],
} = Astro.props
const resolvedConfig = getResolvedSiteConfig(Astro.url.pathname)
const pageTitle = title
  ? `${title} | ${resolvedConfig.siteTitle}`
  : resolvedConfig.siteTitle
const pageDescription = description || resolvedConfig.siteDescription
const ogImagePath =
  Astro.url.pathname === '/'
    ? '/og/index.png'
    : `/og${Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname}.png`
const tocItems = tocHeadings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3
)
const hasFooter = Boolean(
  resolvedConfig.footer.message?.trim() ||
  resolvedConfig.footer.copyright?.trim()
)
---

<!doctype html>
<html lang={resolvedConfig.localeLang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      lang={resolvedConfig.localeLang}
      image={ogImagePath}
      favicon={resolvedConfig.siteFavicon}
      ogType={sidebar ? 'article' : 'website'}
    />
    {customGlobalStyle && <style is:global set:html={customGlobalStyle} />}
  </head>
  <body>
    <Header showSidebarToggle={sidebar} />
    <div class:list={['wrapper', !sidebar && 'wrapper-without-sidebar']}>
      {
        sidebar && (
          <>
            <button
              type="button"
              class="sider-backdrop"
              data-sidebar-backdrop
              data-state="closed"
              aria-label="Close navigation menu"
            />
            <aside
              id="sidebar-drawer"
              class="sider"
              data-sidebar-drawer
              data-state="closed"
            >
              <Sidebar />
            </aside>
          </>
        )
      }
      <main class:list={['content', contentClass]}>
        <div
          class:list={[
            'docs-main',
            tocItems.length > 0 && 'docs-main-with-toc',
          ]}
        >
          <div class="docs-main-content">
            <slot />
          </div>
          <DocToc items={tocItems} />
        </div>
      </main>
    </div>

    {
      hasFooter && (
        <Footer
          message={resolvedConfig.footer.message}
          copyright={resolvedConfig.footer.copyright}
        />
      )
    }

    <script>
      import { setupCodeCopyButtons } from '../scripts/code-copy'
      import { setupSidebarDrawer } from '../scripts/sidebar-drawer'

      setupCodeCopyButtons()

      let sidebarCleanup: (() => void) | null = null

      const mountSidebarDrawer = () => {
        if (typeof sidebarCleanup === 'function') {
          sidebarCleanup()
        }

        sidebarCleanup = setupSidebarDrawer()
      }

      mountSidebarDrawer()
      document.addEventListener('astro:page-load', mountSidebarDrawer)
    </script>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
  }

  .wrapper {
    display: flex;
    position: relative;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
  }

  .sider {
    position: sticky;
    top: var(--header-height);
    width: var(--sidebar-width);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
  }

  .sider-backdrop {
    display: none;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .docs-main {
    width: 100%;
    min-width: 0;
  }

  .wrapper-without-sidebar {
    width: 100%;
  }

  @media (min-width: 1200px) {
    .docs-main-with-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 2rem;
      align-items: start;
    }
  }

  @media (max-width: 900px) {
    .sider-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 20;
      border: 0;
      background: rgba(0 0 0 / 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    .sider-backdrop[data-state='open'] {
      opacity: 1;
      pointer-events: auto;
    }

    .sider {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 30;
      width: min(84vw, 18rem);
      height: 100dvh;
      transform: translateX(-100%);
      transition: transform 220ms ease;
      background: rgba(var(--background-color) / 1);
      border-right: 1px solid rgba(var(--border-color) / 1);
      padding: 5rem 0.5rem 1rem;
      overflow-y: auto;
    }

    .sider[data-state='open'] {
      transform: translateX(0);
    }

    .content {
      border-left: 0;
    }
  }
</style>
