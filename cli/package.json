{
  "name": "stropress",
  "version": "0.0.6",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "stropress": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun build src/index.ts src/runtime.ts --target=node --format=esm --packages=external --outdir dist",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationDir dist",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "dev": "bun src/index.ts dev",
    "pack:check": "bun run build && npm pack --dry-run"
  },
  "dependencies": {
    "@stropress/ui": "^0.0.6",
    "astro": "7.2.6",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "jiti": "^2.7.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
